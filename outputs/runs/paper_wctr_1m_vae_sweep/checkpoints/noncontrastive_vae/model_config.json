{
  "method": "noncontrastive_vae",
  "vae": {
    "epochs": 1260,
    "batch_size": 2048,
    "latent_dim": 512,
    "depth": 4,
    "width_decay": 0.975,
    "lambda_contrastive": 0.0,
    "beta_kl": 0.03,
    "lr": 0.0005,
    "dropout": 0.02,
    "activation": "relu",
    "normalization": "layernorm",
    "contrastive_temperature": 0.1,
    "positive_aug": "light",
    "negative_mode": "marginal",
    "checkpoint_every": 100,
    "early_stopping_patience": 1260,
    "sample_temperature": 0.75,
    "sample_chunk_size": 25000,
    "max_single_file_rows": 1000000,
    "weighting": {
      "use_weight_for_training_loss": true,
      "transform": "capped_normalized",
      "cap_quantile": 0.99,
      "normalize_mean_to_one": true
    }
  },
  "schema": {
    "id_columns": [],
    "weight_column": "weight",
    "exclude_from_synthesis": [
      "weight"
    ],
    "categorical_columns": [
      "o_activity",
      "o_tract_fips",
      "d_activity",
      "d_tract_fips",
      "travel_mode",
      "park_loc",
      "park_pay",
      "hov_used",
      "toll_road_used",
      "vehicle",
      "tolltransponder",
      "home_tract_fips",
      "home_type",
      "home_ownership",
      "tdate_week",
      "tdate_dow",
      "gender",
      "race_ethnicity",
      "race_ethnicity_hispanic",
      "license",
      "disability",
      "smartphone",
      "employment_status",
      "work_tract_fips",
      "student_status",
      "volunteer_status"
    ],
    "ordinal_integer_columns": [
      "departure_time_minutes",
      "reported_travel_time",
      "travelers_hh",
      "travelers_nonhh",
      "vehicle_occupancy",
      "year",
      "hhsize",
      "numstudents",
      "numdrivers",
      "numworkers",
      "numdisabilities",
      "numvehicle",
      "numvehicle_transponder",
      "numbicycle",
      "hh_income_detailed",
      "age",
      "jobs_count"
    ],
    "continuous_columns": [
      "distance"
    ],
    "fips_columns": [
      "o_tract_fips",
      "d_tract_fips",
      "home_tract_fips",
      "work_tract_fips"
    ],
    "integer_cast_columns": {
      "year": {
        "mode": "safe_round",
        "nullable": true
      }
    }
  }
}