#!/usr/bin/env bash
set -euo pipefail

limit_bytes=$((100 * 1024 * 1024))
limit_label="100 MB"
failed=0

while IFS= read -r -d '' path; do
  size_bytes=$(git cat-file -s ":$path" 2>/dev/null || printf '0')

  if [ "$size_bytes" -gt "$limit_bytes" ]; then
    size_mb=$(awk "BEGIN { printf \"%.1f\", $size_bytes / 1024 / 1024 }")
    printf 'ERROR: %s is %s MB, which exceeds the %s GitHub file limit.\n' "$path" "$size_mb" "$limit_label" >&2
    failed=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=AM)

if [ "$failed" -ne 0 ]; then
  printf '\nCommit blocked. Remove large files from the index or store them outside Git.\n' >&2
  exit 1
fi
